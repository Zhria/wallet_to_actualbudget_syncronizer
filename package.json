{
  "name": "wallet-to-actualbudget",
  "version": "0.1.0",
  "description": "Bridge that syncs transactions from Wallet by BudgetBakers into Actual Budget",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "tsx src/cli.ts",
    "schedule": "tsx src/scheduler.ts",
    "wallet:list": "tsx tools/list-wallet-resources.ts",
    "actual:list": "tsx tools/list-actual-resources.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@actual-app/api": "^26.9.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
