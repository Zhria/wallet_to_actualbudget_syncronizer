# Wallet by BudgetBakers (Settings -> API -> generate personal token; requires Premium)
WALLET_API_TOKEN=

# Actual Budget server
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_SERVER_PASSWORD=
ACTUAL_SYNC_ID=
# Optional, only needed if your budget is end-to-end encrypted
ACTUAL_ENCRYPTION_PASSWORD=

# Local dir where the Actual API caches the budget file
ACTUAL_DATA_DIR=./actual-data

# Path to the account/category mapping file (see config/mapping.example.json)
MAPPING_FILE=./config/mapping.json

# How many days back to re-pull on every run. Safe to keep wide since
# importTransactions() dedupes by imported_id, so re-importing is a no-op.
SYNC_LOOKBACK_DAYS=30

# Cron expression used by `npm run schedule` (default: every hour)
SYNC_CRON=0 * * * *
